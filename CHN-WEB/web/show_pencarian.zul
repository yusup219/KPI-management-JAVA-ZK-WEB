<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <window apply="controler.KpiController" width="100%" style="padding:10px;">
        
        <label value="Daftar Nilai KPI Pegawai" style="font-size:20px; font-weight:bold; color:#1e3c72;"/>
        <separator height="15px"/>
        
        <hbox align="center" style="margin-bottom: 15px;">
            <label value="Cari Pegawai : " style="font-weight: bold;" />
            <textbox id="txtCari" width="200px" placeholder="Ketik nama pegawai..." />
            <button id="btnCari" label="Cari" style="background:#1e3c72; color:white; cursor:pointer;" />
            <button id="btnRefresh" label="Refresh" style="cursor:pointer;" />
        </hbox>
        
        <listbox id="listboxKpi" emptyMessage="Data KPI Tidak Ditemukan" mold="paging" pageSize="10">
            <listhead>
                <listheader label="ID KPI" width="80px" sort="auto"/>
                <listheader label="Nama Pegawai" sort="auto"/>
                <listheader label="Hadir Target" width="120px"/>
                <listheader label="Hadir Aktual" width="120px"/>
                <listheader label="Bobot" width="100px"/>
                <listheader label="Skor Akhir" width="120px"/>
                <listheader label="Index Nilai" width="100px"/>
            </listhead>
            </listbox>
        
    </window>
</zk>