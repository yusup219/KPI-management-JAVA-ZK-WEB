<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <window apply="controler.KpiController" width="100%" style="padding:10px;">
        
        <label value="Daftar Nilai KPI Pegawai" style="font-size:20px; font-weight:bold; color:#1e3c72;"/>
        <separator height="15px"/>
        
        <hbox align="center" style="margin-bottom: 15px;">
            <label value="Cari Pegawai : " style="font-weight: bold;" />
            <textbox id="txtCari" width="200px" />
            <button id="btnCari" label="Cari" style="background:#1e3c72; color:white; cursor:pointer;" />
            <button id="btnRefresh" label="Refresh" style="cursor:pointer;" />
            <button id="btnExport" label="Export Excel" style="background:#2e7d32; color:white; cursor:pointer;" />
        </hbox>
         
        <hbox align="center" style="margin-bottom: 15px;"> 
            <label value="Periode Penilaian:" style="font-weight:bold;" width="120px" />
            <datebox id="dbAwal" format="dd-MM-yyyy" readonly="true" width="100px" />
            <label value="TO" style="font-weight:bold;"/>
            <datebox id="dbAkhir" format="dd-MM-yyyy" readonly="true" width="100px" />
            <button id="btnFilter" label="Tampilkan" style="margin-left:15px;" />

        </hbox>


        
        <listbox id="listboxKpi" emptyMessage="Data KPI Tidak Ditemukan" mold="paging" pageSize="5">
            <listhead>
                <listheader label="ID KPI" width="80px"/>
                <listheader label="Nama Pegawai" width="80px"/>
                <listheader label="Hadir Target" width="120px"/>
                <listheader label="Hadir Aktual" width="140px"/> 
                <listheader label="Bobot" width="80px"/>
                <listheader label="Skor Akhir" width="100px"/>
                <listheader label="Index Nilai" width="90px"/>
                <listheader label="Tanggal Penilaian" width="150px"/>
                <listheader label="Aksi" width="129px"/>
            </listhead>
        </listbox>
        
    </window>
</zk>