<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <window id="winLogin"
            border="none"
            width="100%"
            height="100%"
            apply="controler.LoginShow"
            style="background: #124e8c; position:absolute; top:0; left:0; padding:0; margin:0; overflow:hidden;">
        
        <style>
            .custom-link {
            font-size: 12px;
            color: #124e8c;
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
            transition: color 0.2s ease-in-out, text-decoration 0.2s ease-in-out;
            }
            .custom-link:hover {
            color: #1b6ec2; 
            text-decoration: underline;
            }
        </style>

        <hbox width="100%"
              height="100%"
              spacing="0"
              style="height:100vh; width:100%; display:flex;">
              
            <cell width="70%"
                  height="100%"
                  style="overflow:hidden;padding:0;">

                <image src="/foto/lk.png"
                       width="125%"
                       height="1000%"
                       style="object-fit:cover;display:block;"/>

            </cell>
            
            <cell width="30%" height="100%"
                  style="background: #124e8c; 
                         padding:0 30px;
                         vertical-align:middle;
                         height:100vh;">
                         
                <vlayout spacing="0" height="100%" style="display:flex; flex-direction:column; justify-content:center; align-items:center;">
                    
                    <div style="background: #ffffff;
                                padding: 30px 25px;
                                border-radius: 12px;
                                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
                                border: 1px solid #e2e8f0;"
                         width="340px">
                         
                        <vlayout spacing="5px" style="margin-bottom: 20px; text-align: center; width: 100%;">
                            <label value="SELAMAT DATANG"
                                   style="font-size:24px;
                                          font-weight:bold;
                                          color:#1e293b;
                                          display: block;"/>
                            <label value="Silakan masuk untuk mengakses sistem"
                                   style="font-size:12px;
                                          color:#64748b; 
                                          display: block;"/>
                        </vlayout>
                        
                        <vlayout spacing="15px" width="100%">
                            
                            <vlayout spacing="5px" width="100%">
                                <label value="Username"
                                       style="font-size:11px; font-weight:bold; color:#475569; letter-spacing: 0.5px;"/>
                                <textbox id="tbuser"
                                         hflex="1"
                                         height="40px"
                                         style="border:1.5px solid #cbd5e1;
                                                border-radius:6px;
                                                padding:0 10px;
                                                font-size:14px;
                                                color:#1e293b;"/>
                            </vlayout>
                            
                            <vlayout spacing="5px" width="100%">
                                <label value="Password"
                                       style="font-size:11px; font-weight:bold; color:#475569; letter-spacing: 0.5px;"/>
                                <textbox id="tbpass"
                                         type="password"
                                         hflex="1"
                                         height="40px"
                                         style="border:1.5px solid #cbd5e1;
                                                border-radius:6px;
                                                padding:0 10px;
                                                font-size:14px;
                                                color:#1e293b;"
                                         onOK="onClick$buttonLogin"/>
                                         
                                <div style="text-align: left; margin-top: 3px;">
                                    <a id="linkLupaPass" label="Lupa password?" sclass="custom-link"/>
                                </div>
                            </vlayout>
                            
                            <separator height="5px"/>
                            
                            <button id="buttonLogin"
                                    label="Masuk"
                                    width="100%"
                                    style="height:42px;
                                           background: linear-gradient(135deg, #1b6ec2 0%, #124e8c 100%);
                                           color:#ffffff;
                                           border:none;
                                           border-radius:6px;
                                           font-size:14px;
                                           font-weight:bold;
                                           cursor:pointer;"/>
                                           
                            <separator height="5px"/>
                            
                            <hbox width="100%" style="display:flex; justify-content:center; align-items:center; gap: 5px;">
                                <label value="Belum punya akun?" style="color:#64748b; font-size:12px;"/>
                                <a id="linkDaftar" label="Daftar Sekarang" sclass="custom-link"/>
                            </hbox>
                            
                        </vlayout>
                    </div>
                </vlayout>
            </cell>
        </hbox>
    </window>
</zk>